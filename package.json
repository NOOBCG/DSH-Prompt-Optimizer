{
  "name": "@noobcg/dsh-prompt-optimizer",
  "version": "1.0.0",
  "description": "Adds a prompt-optimizer button to the chat composer that rewrites the current draft into a clearer, more actionable prompt.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NOOBCG/DSH-Prompt-Optimizer.git"
  },
  "homepage": "https://github.com/NOOBCG/DSH-Prompt-Optimizer#readme",
  "bugs": {
    "url": "https://github.com/NOOBCG/DSH-Prompt-Optimizer/issues"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.3 <0.3.0"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "INSTALL.md",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}

